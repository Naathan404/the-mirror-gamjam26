  endingLines:
  - text: The door is open...
    sfx: {fileID: 8300000, guid: 635da2ab5fe8ab24e811c068ce2ca39c, type: 3}
    delayBeforeShow: 1
    showDuration: 2
    triggerJumpscareAfter: 0
  - text: "\u2026but why is there no way out?"
    sfx: {fileID: 8300000, guid: 8ad7f08f353284d42b713de553d2da95, type: 3}
    delayBeforeShow: 0
    showDuration: 3
    triggerJumpscareAfter: 0
  - text: "Because this cage\u2026"
    sfx: {fileID: 8300000, guid: 9abed6fb2a253e941bf5a3fa3992e836, type: 3}
    delayBeforeShow: 0
    showDuration: 4
    triggerJumpscareAfter: 0
  - text: ...was built to hold only one thing
    sfx: {fileID: 0}
    delayBeforeShow: 0
    showDuration: 5
    triggerJumpscareAfter: 0
  - text: YOU
    sfx: {fileID: 0}
    delayBeforeShow: 0
    showDuration: 1
    triggerJumpscareAfter: 1
  loopButtonText: Wake up ... again
